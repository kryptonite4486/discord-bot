# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Optional: Discord application / client ID
DISCORD_APP_ID=

# Command prefix for legacy/prefix commands
COMMAND_PREFIX=!

# SQLite database path (inside container: /app/data/weekly.db)
DATABASE_PATH=/app/data/weekly.db

# Channel ID that accepts OCR image uploads (optional; leave empty to disable auto-ingest)
OCR_CHANNEL_ID=

# OCR engine: easyocr | tesseract
OCR_ENGINE=easyocr

# Default week start (ISO date YYYY-MM-DD). Empty = current week's Monday.
DEFAULT_WEEK_START=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Guild ID for faster slash-command sync during development (optional)
DEV_GUILD_ID=