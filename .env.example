# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Optional: Discord application / client ID
DISCORD_APP_ID=

# Privileged Message Content Intent (must also be ON in Developer Portal if true)
# Set false temporarily if the portal intent is disabled and you only need slash commands
MESSAGE_CONTENT_INTENT=true

# Command prefix for legacy/prefix commands
COMMAND_PREFIX=!

# SQLite database path (inside container: /app/data/weekly.db)
DATABASE_PATH=/app/data/weekly.db

# Host folders mounted into the container (docker-compose.yml requires both).
# Keep them outside the repo; use absolute paths. Backups should live somewhere
# synced or on another disk, never next to the live database.
BOT_DATA_DIR=/Users/you/DiscordBot/data
BOT_BACKUP_DIR=/Users/you/Documents/DiscordBot-dataBackup
# Daily backups to keep (manual copies from /ops backup and safety backups: newest 10)
BACKUP_KEEP=14
# Oldest any backup may get, daily or manual (the newest one is always kept)
BACKUP_MAX_AGE_DAYS=30

# Days a server's data is kept after the bot is removed from it (or after its
# subscription ends, if later; nothing is deleted while one is active).
# Re-adding the bot within this window keeps everything.
DATA_RETENTION_DAYS=30

# OpenAI-compatible vision OCR (oMLX / Qwen2.5-VL). This is the only OCR engine.
# From the host: http://127.0.0.1:8000/v1
# From Docker on Mac: http://host.docker.internal:8000/v1
OCR_VISION_BASE_URL=http://host.docker.internal:8000/v1
# Must match an id from GET {OCR_VISION_BASE_URL}/models (oMLX often appends -4bit)
OCR_VISION_MODEL=Qwen2.5-VL-7B-Instruct-4bit
# Fill in your oMLX API token; empty Bearer is sent if unset
OCR_VISION_API_KEY=
OCR_VISION_TIMEOUT=120
# Images sent to the vision server at once, across all uploads. Keep at 1:
# oMLX garbles Qwen2.5-VL replies when it batches several requests together.
OCR_MAX_CONCURRENCY=1

# Default week start (YYYY-MM-DD). Empty = current week's Sunday.
DEFAULT_WEEK_START=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Bot operator: Discord user IDs (comma-separated) allowed to run /ops
# commands (reload, sync, backup), and the private server where /ops appears.
# /ops is hidden from every other server. Leave either empty to disable /ops.
BOT_OWNER_IDS=
CONTROL_GUILD_ID=

# Development only: register commands in this one server (instant updates)
# instead of globally. Leave empty in production.
DEV_GUILD_ID=

# When upgrading an existing DB that lacks GuildId, set this to your Discord
# server snowflake so historical rows are assigned to that guild on startup.
# If unset, migrated rows get GuildId=legacy and a warning is logged.
LEGACY_GUILD_ID=

# Territory planner web app linked by /planner (default: the hosted Cloudflare Pages site)
PLANNER_URL=
